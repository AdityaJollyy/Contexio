# ============ Server ============
PORT=3000
DATABASE_URL=mongodb+srv://contexio_app:YOUR_ATLAS_PASSWORD@contexio.xxxxx.mongodb.net/contexio?retryWrites=true&w=majority
# 96 hex chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_GENERATED_SECRET
ALLOWED_ORIGINS=http://localhost:5173

# ============ Redis (BullMQ queue) ============
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT

# ============ Gemini ============
GEMINI_API_KEY=PASTE_AI_STUDIO_KEY
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_MS=30000

# ============ Background worker ============
WORKER_CONCURRENCY=3
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_MS=5000
WORKER_RATE_LIMIT_MAX=8
WORKER_RATE_LIMIT_DURATION_MS=60000
RUN_WORKER_IN_API=true

# ============ Per-user AI quota ============
AI_CHAT_DAILY_LIMIT=10

# ============ Per-user limits ============
MAX_ITEMS_PER_USER=1000
CONTENT_WRITE_RATE_MAX=60
PLAIN_SEARCH_RATE_MAX=120

# ============ Extraction ============
YOUTUBE_API_KEY=PASTE_GOOGLE_CLOUD_KEY
SCRAPER_TIMEOUT_MS=8000
SCRAPER_MAX_BYTES=2000000
SCRAPER_MAX_CHARS=30000

# ============ Chunking ============
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_ITEM=20

# ============ Plain search ============
MAX_QUERY_CHARS=200
BROWSE_SEARCH_LIMIT=50
FUZZY_FALLBACK_MIN=3

# ============ AI search ============
VECTOR_NUM_CANDIDATES=300
VECTOR_SEARCH_LIMIT=80
RAG_TOP_K=5
RELEVANCE_MIN_SCORE=0.80
RELEVANCE_COUNT_LIMIT=2000
ALL_MATCHES_LIMIT=50